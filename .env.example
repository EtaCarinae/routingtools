# Obligatoria, pero no es una API key: Nominatim pide un User-Agent que te identifique
# (un email o la URL de tu proyecto). https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=routetools/1.0 (email@example.com)

# Opcional: LLM árbitro para la zona gris (https://openrouter.ai)
OPENROUTER_API_KEY=

# Opcional: segundo geocoder (elegilo con escalation_provider en config/settings.yaml)
OPENCAGE_API_KEY=
GOOGLE_MAPS_API_KEY=
